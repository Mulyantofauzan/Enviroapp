{
  "name": "evo-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "evo-evidence" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "evo", "database_id": "642ef8ae-dff6-4401-9707-58b6d4d50fb9", "migrations_dir": "migrations" }
  ]
}
