{
  "name": "evo-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "evo-evidence" },
    { "binding": "BACKUP", "bucket_name": "enviro-backup" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "evo", "database_id": "local-dev-placeholder", "migrations_dir": "migrations" }
  ]
}
